  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "AcceptLanguage": {
        "name": "Accept-Language",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "ar",
            "en"
          ],
          "default": "ar"
        },
        "description": "Both languages remain present in translatable response messages."
      }
    },
    "schemas": {
      "BilingualMessage": {
        "type": "object",
        "properties": {
          "ar": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ar",
          "en"
        ]
      },
      "OtpRequest": {
        "type": "object",
        "properties": {
          "phone_e164": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{1,14}$",
            "examples": [
              "+963912345678"
            ]
          }
        },
        "required": [
          "phone_e164"
        ]
      },
      "ChallengeRequest": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "challenge_id"
        ]
      },
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "challenge_id",
          "code"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1
          },
          "phone_e164": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{1,14}$",
            "examples": [
              "+963912345678"
            ]
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "resend_after_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "attempts_remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "challenge_id",
          "phone_e164",
          "expires_in_seconds",
          "resend_after_seconds",
          "attempts_remaining"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phone_e164": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{1,14}$",
            "examples": [
              "+963912345678"
            ]
          },
          "phone_verified": {
            "type": "boolean"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC timestamp"
          }
        },
        "required": [
          "id",
          "phone_e164",
          "phone_verified",
          "created_at"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "access_token": {
            "type": "string",
            "minLength": 1
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "refresh_token": {
            "type": "string",
            "minLength": 1
          },
          "refresh_expires_in_seconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "token_type",
          "access_token",
          "expires_in_seconds",
          "refresh_token",
          "refresh_expires_in_seconds"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "$ref": "#/components/schemas/BilingualMessage"
              },
              "attempts_remaining": {
                "type": "integer",
                "minimum": 0
              },
              "retry_after_seconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ChallengeResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Challenge"
          }
        },
        "required": [
          "data"
        ]
      },
      "VerificationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              },
              "is_new_user": {
                "type": "boolean"
              }
            },
            "required": [
              "user",
              "session",
              "is_new_user"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "session"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              }
            },
            "required": [
              "user"
            ]
          }
        },
        "required": [
          "data"
        ]
      }
    }
  },
  "x-contract-error-codes": {
    "422": [
      "PHONE_INVALID",
      "OTP_INVALID",
      "OTP_CHALLENGE_INVALID"
    ],
    "410": [
      "OTP_EXPIRED"
    ],
    "429": [
      "OTP_TOO_MANY_ATTEMPTS",
      "OTP_RESEND_TOO_EARLY",
      "RATE_LIMITED"
    ],
    "503": [
      "OTP_DELIVERY_UNAVAILABLE",
      "SERVICE_UNAVAILABLE"
    ],
    "401": [
      "SESSION_INVALID",
      "SESSION_REVOKED"
    ],
    "403": [
      "ACCOUNT_DISABLED",
      "FORBIDDEN"
    ],
    "500": [
      "INTERNAL_ERROR"
    ]
  }
}
