    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked or already revoked; no response body. Access token is not required."
          },
          "429": {
            "description": "OTP_TOO_MANY_ATTEMPTS / OTP_RESEND_TOO_EARLY / RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
