{
  "openapi": "3.1.0",
  "info": {
    "title": "Tam Authentication API",
    "version": "1.0.0",
    "description": "Required contract, not a deployed API. The user-supplied authentication-v1.md is authoritative for behavioral requirements. No guest endpoint."
  },
  "servers": [
    {
      "url": "https://api.example.com/api/v1",
      "description": "Placeholder; replace with actual staging URL."
    }
  ],
  "paths": {
    "/auth/otp/request": {
      "post": {
        "operationId": "requestOtp",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                },
                "example": {
                  "data": {
                    "challenge_id": "ch_8f6c91...",
                    "phone_e164": "+963912345678",
                    "expires_in_seconds": 120,
                    "resend_after_seconds": 60,
                    "attempts_remaining": 5
                  }
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_DISABLED / FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "PHONE_INVALID / OTP_INVALID / OTP_CHALLENGE_INVALID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP_TOO_MANY_ATTEMPTS / OTP_RESEND_TOO_EARLY / RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Required for RATE_LIMITED; seconds until retry is allowed.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "OTP_DELIVERY_UNAVAILABLE / SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          }
        }
      }
    },
    "/auth/otp/resend": {
      "post": {
        "operationId": "resendOtp",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                },
                "example": {
                  "data": {
                    "challenge_id": "ch_8f6c91...",
                    "phone_e164": "+963912345678",
                    "expires_in_seconds": 120,
                    "resend_after_seconds": 60,
                    "attempts_remaining": 4
                  }
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_DISABLED / FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "OTP_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "PHONE_INVALID / OTP_INVALID / OTP_CHALLENGE_INVALID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP_TOO_MANY_ATTEMPTS / OTP_RESEND_TOO_EARLY / RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Required for RATE_LIMITED; seconds until retry is allowed.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "OTP_DELIVERY_UNAVAILABLE / SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeRequest"
              }
            }
          }
        },
        "description": "Retain challenge_id; issue a new code and invalidate the previous one. Resending cannot reset the attempt budget."
      }
    },
    "/auth/otp/verify": {
      "post": {
        "operationId": "verifyOtp",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                },
                "example": {
                  "data": {
                    "user": {
                      "id": "b8a9c7d1-2e44-4df3-9012-6f8a2b47e921",
                      "phone_e164": "+963912345678",
                      "phone_verified": true,
                      "display_name": null,
                      "created_at": "2026-11-04T12:00:00Z"
                    },
                    "session": {
                      "token_type": "Bearer",
                      "access_token": "<access_token>",
                      "expires_in_seconds": 900,
                      "refresh_token": "<refresh_token>",
                      "refresh_expires_in_seconds": 2592000
                    },
                    "is_new_user": true
                  }
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_DISABLED / FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "OTP_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "PHONE_INVALID / OTP_INVALID / OTP_CHALLENGE_INVALID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP_TOO_MANY_ATTEMPTS / OTP_RESEND_TOO_EARLY / RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Required for RATE_LIMITED; seconds until retry is allowed.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "OTP_DELIVERY_UNAVAILABLE / SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          }
        },
        "description": "Atomically consume the OTP, find or create the user and issue a session. Never reveal account existence before verification."
      }
    },
    "/auth/token/refresh": {
      "post": {
        "operationId": "refreshToken",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                },
                "example": {
                  "data": {
                    "session": {
                      "token_type": "Bearer",
                      "access_token": "<new_access_token>",
                      "expires_in_seconds": 900,
                      "refresh_token": "<new_refresh_token>",
                      "refresh_expires_in_seconds": 2592000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "SESSION_INVALID / SESSION_REVOKED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_DISABLED / FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP_TOO_MANY_ATTEMPTS / OTP_RESEND_TOO_EARLY / RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Required for RATE_LIMITED; seconds until retry is allowed.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "OTP_DELIVERY_UNAVAILABLE / SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "description": "Rotate both tokens, invalidate the old refresh token, handle duplicate/concurrent refreshes explicitly. TTLs are server-controlled."
      }
    },
